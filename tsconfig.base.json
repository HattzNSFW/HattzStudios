{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@hattz/core": ["packages/core/src/index.ts"],
      "@hattz/contracts": ["packages/contracts/src/index.ts"],
      "@hattz/design-system": ["packages/design-system/src/index.ts"],
      "@hattz/permissions": ["packages/permissions/src/index.ts"],
      "@hattz/validation": ["packages/validation/src/index.ts"],
      "@hattz/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@hattz/local-store/testing": ["packages/local-store/src/trustedAuthority.ts"],
      "@hattz/local-store": ["packages/local-store/src/index.ts"],
      "@hattz/profile-view": ["packages/profile-view/src/index.ts"]
    }
  }
}
