{
  "name": "hattz-2.0",
  "version": "0.1.0",
  "private": true,
  "description": "Hättz 2.0 — monorepo (Share, Studio, Control)",
  "license": "UNLICENSED",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24 <25 || >=26 <27",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:share": "npm run dev --workspace @hattz/share",
    "dev:studio": "npm run dev --workspace @hattz/studio",
    "dev:control": "npm run dev --workspace @hattz/control",
    "dev:hub": "vite --config vite.hub.config.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p infrastructure/adapters/tsconfig.json --noEmit && tsc -p tsconfig.hub.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "media:parity": "node infrastructure/supabase/validation/parity/check_media_parity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "6.2.5",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "dexie": "4.3.0"
  }
}
